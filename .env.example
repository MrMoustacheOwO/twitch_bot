# Twitch
TWITCH_CHANNEL=your_channel_name
TWITCH_ACCOUNTS_CONFIG_PATH=config/twitch_accounts.json

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_MAX_CONCURRENT=1

# STT
STT_MODEL_SIZE=large-v3
STT_LANGUAGE=ru
STT_DEVICE=cuda

# Vision
VISION_FRAME_INTERVAL_SEC=10
STREAM_URL=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/twitch_bots

# Scheduler
SNAPSHOT_INTERVAL_SEC=5
BOT_CONFIG_PATH=config/bots.json

# API
API_HOST=0.0.0.0
API_PORT=8000
